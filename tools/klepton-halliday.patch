diff --git a/source/runtime/jni/kl_jni_appsession.c b/source/runtime/jni/kl_jni_appsession.c
new file mode 100644
index 0000000..5fd3ec9
--- /dev/null
+++ b/source/runtime/jni/kl_jni_appsession.c
@@ -0,0 +1,179 @@
+// An app in two halves: an interface (a web application in one activity) that
+// starts a player (a NativeActivity) with a description of what to play. Added
+// for Halliday (ROADMAP W15.3), which hosts the interface itself.
+//
+// The player's library asks its activity for the session and reports back
+// through methods of its own. Which methods, and how each is answered, is not
+// written here: whoever starts the runner says so, in a file named by
+// KL_APP_JAVA, a line per method:
+//
+//   <method> <JNI signature> <answer>
+//
+// with one of these answers (Halliday writes the file from the manifest of
+// the app's extension, docs/extensions.md in Halliday):
+//
+//   session   String: the text of the file named by KL_APP_SESSION
+//   end       void: the session is over; the runner ends, with the method's
+//             first int as its status when it has one (0: as it should)
+//   ignore    void: nothing (logged)
+//   false, true, zero   boolean or int
+//   empty     String: ""
+//
+// Intent.getStringExtra(key) is answered for any app from KL_APP_EXTRAS, a
+// file of `key=value` lines. With none of these set, nothing here answers and
+// the runner behaves as it did.
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include "guest/kl_driver.h"
+#include "kl_jni_int.h"
+
+static klj_val as_session(void *env, void *self, const klj_val *a, int n) {
+    (void)env; (void)self; (void)a; (void)n;
+    const char *path = getenv("KL_APP_SESSION");
+    char *text = NULL;
+    if (path) {
+        FILE *f = fopen(path, "rb");
+        if (f) {
+            fseek(f, 0, SEEK_END);
+            long size = ftell(f);
+            fseek(f, 0, SEEK_SET);
+            if (size >= 0 && (text = calloc(1, (size_t)size + 1)) != NULL &&
+                fread(text, 1, (size_t)size, f) != (size_t)size) {
+                free(text);
+                text = NULL;
+            }
+            fclose(f);
+        }
+    }
+    KLJ_LOG("activity: session asked for -> %s (%zu bytes)",
+            text ? path : "no session given (KL_APP_SESSION): empty", text ? strlen(text) : 0);
+    void *s = kl_jni_new_string(text ? text : "");
+    free(text);
+    return (klj_val){.l = s};
+}
+
+// For `end` the status is the first argument when the signature starts with
+// an int; set per binding when the table is read (the impl can't see it).
+static klj_val end_with(int code) {
+    KLJ_LOG("activity: session ended (%d)", code);
+    // On a headset the activity now finishes and the interface comes back.
+    // Here the player is all there is: with its session over, the process ends
+    // too, so whoever started it (Halliday) sees it go instead of an empty
+    // picture.
+    fprintf(stderr, "[halliday] session ended: %s\n", code ? "failed" : "finished");
+    fflush(NULL);
+    _exit(code == 0 ? 0 : 3);
+    return (klj_val){0};
+}
+static klj_val as_end_int(void *env, void *self, const klj_val *a, int n) {
+    (void)env; (void)self;
+    return end_with(n > 0 ? (int)a[0].j : 0);
+}
+static klj_val as_end(void *env, void *self, const klj_val *a, int n) {
+    (void)env; (void)self; (void)a; (void)n;
+    return end_with(0);
+}
+
+static klj_val as_ignore(void *env, void *self, const klj_val *a, int n) {
+    (void)env; (void)self; (void)a; (void)n;
+    KLJ_LOG_ONCE("activity: a method answered with nothing (KL_APP_JAVA)");
+    return (klj_val){0};
+}
+static klj_val as_false(void *env, void *self, const klj_val *a, int n) {
+    (void)env; (void)self; (void)a; (void)n;
+    return (klj_val){.j = 0};
+}
+static klj_val as_true(void *env, void *self, const klj_val *a, int n) {
+    (void)env; (void)self; (void)a; (void)n;
+    return (klj_val){.j = 1};
+}
+static klj_val as_empty(void *env, void *self, const klj_val *a, int n) {
+    (void)env; (void)self; (void)a; (void)n;
+    return (klj_val){.l = kl_jni_new_string("")};
+}
+
+// The table from KL_APP_JAVA, read once.
+static klj_binding *g_table;
+static int g_count;
+static pthread_once_t g_once = PTHREAD_ONCE_INIT;
+
+static void read_table(void) {
+    const char *path = getenv("KL_APP_JAVA");
+    if (!path || !*path) return;
+    FILE *f = fopen(path, "rb");
+    if (!f) {
+        KLJ_LOG("KL_APP_JAVA: %s can't be read", path);
+        return;
+    }
+    int cap = 0;
+    char line[1024];
+    while (fgets(line, sizeof line, f)) {
+        char method[256], sig[512], answer[32];
+        if (sscanf(line, "%255s %511s %31s", method, sig, answer) != 3) continue;
+        klj_impl fn = NULL;
+        if (strcmp(answer, "session") == 0) fn = as_session;
+        else if (strcmp(answer, "end") == 0) fn = strncmp(sig, "(I", 2) == 0 ? as_end_int : as_end;
+        else if (strcmp(answer, "ignore") == 0) fn = as_ignore;
+        else if (strcmp(answer, "false") == 0 || strcmp(answer, "zero") == 0) fn = as_false;
+        else if (strcmp(answer, "true") == 0) fn = as_true;
+        else if (strcmp(answer, "empty") == 0) fn = as_empty;
+        if (!fn) {
+            KLJ_LOG("KL_APP_JAVA: \"%s\" for %s isn't an answer the runner knows", answer, method);
+            continue;
+        }
+        if (g_count == cap) {
+            cap = cap ? cap * 2 : 8;
+            klj_binding *grown = realloc(g_table, (size_t)cap * sizeof *g_table);
+            if (!grown) break;
+            g_table = grown;
+        }
+        g_table[g_count++] = (klj_binding){"", strdup(method), strdup(sig), fn};
+    }
+    fclose(f);
+    KLJ_LOG("KL_APP_JAVA: %d method%s answered", g_count, g_count == 1 ? "" : "s");
+}
+
+// Intent.getStringExtra(key): what else the interface handed over with the
+// session. KL_APP_EXTRAS names a file of `key=value` lines; a key not in it is
+// null, as on Android. Every key asked for is logged, since which ones the
+// player reads is only known by running it.
+static klj_val as_extra(void *env, void *self, const klj_val *a, int n) {
+    (void)env; (void)self;
+    const char *key = n > 0 ? klj_str(a[0].l) : NULL;
+    const char *path = getenv("KL_APP_EXTRAS");
+    void *found = NULL;
+    if (key && path) {
+        FILE *f = fopen(path, "rb");
+        if (f) {
+            static char line[65536];
+            size_t klen = strlen(key);
+            while (!found && fgets(line, sizeof line, f)) {
+                if (strncmp(line, key, klen) == 0 && line[klen] == '=') {
+                    char *value = line + klen + 1;
+                    value[strcspn(value, "\r\n")] = 0;
+                    found = kl_jni_new_string(value);
+                }
+            }
+            fclose(f);
+        }
+    }
+    KLJ_LOG("Intent.getStringExtra(\"%s\") -> %s", key ? key : "", found ? "given" : "null");
+    return (klj_val){.l = found};
+}
+static const klj_binding k_extra = {"", "getStringExtra", "(Ljava/lang/String;)Ljava/lang/String;", as_extra};
+
+// The activity's class is whatever the driver names it (the manifest's, or
+// the default): the names are matched whatever the class.
+const klj_binding *klj_appsession_binding(const char *cls, const char *name, const char *sig) {
+    (void)cls;
+    if (!name || !sig) return NULL;
+    pthread_once(&g_once, read_table);
+    for (int i = 0; i < g_count; i++)
+        if (strcmp(name, g_table[i].name) == 0 && strcmp(sig, g_table[i].sig) == 0) return &g_table[i];
+    const char *extras = getenv("KL_APP_EXTRAS");
+    if (extras && *extras && strcmp(name, k_extra.name) == 0 && strcmp(sig, k_extra.sig) == 0) return &k_extra;
+    return NULL;
+}
