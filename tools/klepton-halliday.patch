+// wcsrtombs, for Halliday (the same library). wchar_t is 32 bits on both sides;
+// bionic's mbstate_t is 4 bytes and Darwin's 128, so the guest's is never handed
+// to Darwin: UTF-8 has no shift state to keep between calls.
+size_t klb_wcsrtombs(char *dst, const uint32_t **src, size_t len, void *ps) {
+    (void)ps;
+    const uint32_t *s = *src;
+    size_t n = 0;
+    for (;; s++) {
+        uint32_t c = *s;
+        char b[4];
+        size_t k;
+        if (c < 0x80) { b[0] = (char)c; k = 1; }
+        else if (c < 0x800) { b[0] = (char)(0xC0 | c >> 6); b[1] = (char)(0x80 | (c & 0x3F)); k = 2; }
+        else if (c < 0x10000) {
+            if (c >= 0xD800 && c < 0xE000) { errno = EILSEQ; return (size_t)-1; }
+            b[0] = (char)(0xE0 | c >> 12); b[1] = (char)(0x80 | (c >> 6 & 0x3F)); b[2] = (char)(0x80 | (c & 0x3F)); k = 3;
+        } else if (c < 0x110000) {
+            b[0] = (char)(0xF0 | c >> 18); b[1] = (char)(0x80 | (c >> 12 & 0x3F));
+            b[2] = (char)(0x80 | (c >> 6 & 0x3F)); b[3] = (char)(0x80 | (c & 0x3F)); k = 4;
+        } else { errno = EILSEQ; return (size_t)-1; }
+        if (c == 0) {                       // the terminator is stored, not counted
+            if (dst) { if (n >= len) break; dst[n] = 0; *src = NULL; }
+            return n;
+        }
+        if (dst) {
+            if (n + k > len) break;
+            memcpy(dst + n, b, k);
+        }
+        n += k;
+    }
+    *src = s;
+    return n;
+}
