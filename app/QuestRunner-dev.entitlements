<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Klepton's runner in development builds only. Signed with the local "Halliday Dev" identity,
  which has no Team ID, the hardened runtime would refuse the runner's own libraries (SDL3,
  MoltenVK, the OpenXR runtime): library validation is off for that reason alone.
  Releases sign the runner and its libraries with one team's Developer ID and give it no
  entitlements at all: measured, a Quest app's player ran as before (the same frames
  a second) with the hardened runtime, library validation on and no exceptions.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
